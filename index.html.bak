<!DOCTYPE html>
<html lang="id" class="scroll-smooth">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TunamSam | Agensi Web Development & Design Modern</title>
    <meta name="description"
        content="TunamSam membantu bisnis berkembang melalui website modern, cepat, dan elegan. Jasa pembuatan website, aplikasi web, dan UI/UX design.">

    <!-- Typography -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Roboto+Slab:wght@100..900&family=Outfit:wght@300;400;500;600;700;800&family=Inter:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            DEFAULT: '#026937',
                            light: '#00bf63',
                            dark: '#004d28',
                        },
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        heading: ['Roboto Slab', 'serif'],
                    },
                    maxWidth: {
                        '8xl': '1440px',
                    },
                    animation: {
                        'slider-progress': 'slider-progress 5s linear forwards',
                    },
                    keyframes: {
                        'slider-progress': {
                            '0%': { width: '0%' },
                            '100%': { width: '100%' },
                        }
                    }

                }
            }
        }
    </script>

    <!-- Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <style>
        body {
            background-color: #ffffff;
            color: #333333;
            overflow-x: clip;
        }

        .text-gradient {
            background: linear-gradient(135deg, #008f4a 0%, #00bf63 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .slider-container {
            position: relative;
            width: 100%;
            height: 100%;
            overflow: hidden;
        }

        .slide {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            opacity: 0;
            transition: opacity 0.8s ease-in-out, transform 0.8s ease-in-out;
            transform: scale(1.02);
        }

        .slide.active {
            opacity: 1;
            transform: scale(1);
            z-index: 10;
        }

        .wave-container {
            position: absolute;
            bottom: -50px;
            left: 0;
            width: 100%;
            overflow: hidden;
            line-height: 0;
        }

        .wave-container svg {
            position: relative;
            display: block;
            width: 200%;
            height: 300px;
        }

        /* Wave Animation - Perfectly Seamless Flow */
        .wave-path-1 {
            animation: wave-flow 4s linear infinite;
        }

        .wave-path-2 {
            animation: wave-flow 8s linear infinite;
        }

        .wave-path-3 {
            animation: wave-flow 12s linear infinite;
        }

        @keyframes wave-flow {
            0% {
                transform: translateX(0);
            }

            100% {
                transform: translateX(-50%);
            }
        }



        /* Language Dropdown Custom Styles */
        .lang-dropdown {
            display: none;
            position: absolute;
            top: 100%;
            right: 0;
            margin-top: 0.5rem;
            background-color: white;
            border-radius: 0.75rem;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
            border: 1px solid rgba(0, 0, 0, 0.05);
            min-width: 120px;
            z-index: 200;
            overflow: hidden;
        }

        .lang-dropdown.show {
            display: block;
            animation: fadeInScale 0.2s ease-out forwards;
        }

        @keyframes fadeInScale {
            from {
                opacity: 0;
                transform: scale(0.95) translateY(-10px);
            }

            to {
                opacity: 1;
                transform: scale(1) translateY(0);
            }
        }

        /* Marquee Animation */
        .marquee-container {
            overflow: hidden;
            white-space: nowrap;
            position: relative;
        }

        .marquee-content {
            display: inline-flex;
            animation: marquee-scroll 40s linear infinite;
            gap: 4rem;
            align-items: center;
        }

        @keyframes marquee-scroll {
            from {
                transform: translateX(0);
            }

            to {
                transform: translateX(-50%);
            }
        }

        .marquee-container:hover .marquee-content {
            animation-play-state: paused;
        }

        .animate-marquee-slow {
            animation: marquee-scroll 60s linear infinite !important;
        }

        /* TunamSam Contextual Collage Styling - Ultra Smooth & Lazy */
        .collage-container {
            position: relative;
            width: 100%;
            height: 500px;
            display: flex;
            align-items: center;
            justify-content: center;
            perspective: 1500px;
        }

        .elementor-absolute {
            position: absolute !important;
            transition: transform 1.5s cubic-bezier(0.25, 1, 0.5, 1);
            will-change: transform;
        }

        .collage-container img {
            border-radius: 1.5rem;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
            width: 100%;
            height: auto;
            border: 1px solid rgba(0, 0, 0, 0.03);
            animation: floating 8s ease-in-out infinite;
        }

        @keyframes floating {

            0%,
            100% {
                transform: translateY(0);
            }

            50% {
                transform: translateY(-15px);
            }
        }

        /* Variant 1: Standard Spread */
        .collage-v1 .img-1 {
            width: 35%;
            top: 0;
            left: 0;
            z-index: 1;
            transition-delay: 0.1s;
        }

        .collage-v1 .img-2 {
            width: 45%;
            top: 5%;
            right: 0;
            z-index: 2;
            transition-delay: 0s;
        }

        .collage-v1 .img-3 {
            width: 72%;
            top: 15%;
            left: 8%;
            z-index: 5;
            transition-delay: 0.05s;
        }

        .collage-v1 .img-4 {
            width: 40%;
            bottom: 5%;
            right: -5%;
            z-index: 4;
            transition-delay: 0.15s;
        }

        .collage-v1 .img-5 {
            width: 38%;
            bottom: 0;
            left: -8%;
            z-index: 3;
            transition-delay: 0.2s;
        }

        .collage-v1:hover .img-1 {
            transform: translate(-60px, -40px) rotate(-6deg);
        }

        .collage-v1:hover .img-2 {
            transform: translate(80px, -80px) rotate(8deg);
        }

        .collage-v1:hover .img-3 {
            transform: scale(1.1) translate(0, 20px);
        }

        .collage-v1:hover .img-4 {
            transform: translate(100px, 80px) rotate(-5deg);
        }

        .collage-v1:hover .img-5 {
            transform: translate(-80px, 70px) rotate(9deg);
        }

        /* Variant 2: Horizontal Scattered */
        .collage-v2 .img-1 {
            width: 40%;
            top: 10%;
            left: -10%;
            z-index: 2;
        }

        .collage-v2 .img-2 {
            width: 40%;
            bottom: 10%;
            left: 10%;
            z-index: 1;
        }

        .collage-v2 .img-3 {
            width: 65%;
            top: 20%;
            right: 5%;
            z-index: 5;
        }

        .collage-v2 .img-4 {
            width: 30%;
            top: -5%;
            right: 20%;
            z-index: 3;
        }

        .collage-v2 .img-5 {
            width: 35%;
            bottom: -5%;
            right: 0%;
            z-index: 4;
        }

        .collage-v2:hover .img-1 {
            transform: translate(-80px, 20px) rotate(-4deg);
        }

        .collage-v2:hover .img-2 {
            transform: translate(-40px, 80px) rotate(5deg);
        }

        .collage-v2:hover .img-3 {
            transform: scale(1.15) translate(30px, 0);
        }

        .collage-v2:hover .img-4 {
            transform: translate(20px, -60px) rotate(-8deg);
        }

        .collage-v2:hover .img-5 {
            transform: translate(60px, 40px) rotate(4deg);
        }

        /* Variant 3: Vertical Stack */
        .collage-v3 .img-1 {
            width: 45%;
            top: 0;
            left: 20%;
            z-index: 1;
        }

        .collage-v3 .img-2 {
            width: 55%;
            top: 25%;
            left: 0%;
            z-index: 3;
        }

        .collage-v3 .img-3 {
            width: 50%;
            top: 35%;
            right: 0%;
            z-index: 5;
        }

        .collage-v3 .img-4 {
            width: 60%;
            bottom: 0;
            left: 15%;
            z-index: 2;
        }

        .collage-v3 .img-5 {
            width: 30%;
            top: 15%;
            right: 10%;
            z-index: 4;
        }

        .collage-v3:hover .img-1 {
            transform: translateY(-80px) rotate(-4deg);
        }

        .collage-v3:hover .img-2 {
            transform: translateX(-60px) rotate(6deg);
        }

        .collage-v3:hover .img-3 {
            transform: translateX(60px) scale(1.15);
        }

        .collage-v3:hover .img-4 {
            transform: translateY(80px) rotate(-3deg);
        }

        .collage-v3:hover .img-5 {
            transform: translate(40px, -40px) rotate(8deg);
        }

        /* Variant 4: Exploded Grid */
        .collage-v4 .img-1 {
            width: 35%;
            top: 0;
            right: 0;
            z-index: 1;
        }

        .collage-v4 .img-2 {
            width: 35%;
            top: 0;
            left: 0;
            z-index: 2;
        }

        .collage-v4 .img-3 {
            width: 80%;
            top: 25%;
            left: 10%;
            z-index: 5;
        }

        .collage-v4 .img-4 {
            width: 35%;
            bottom: 0;
            left: 0;
            z-index: 3;
        }

        .collage-v4 .img-5 {
            width: 35%;
            bottom: 0;
            right: 0;
            z-index: 4;
        }

        .collage-v4:hover .img-1 {
            transform: translate(100px, -100px) rotate(8deg);
        }

        .collage-v4:hover .img-2 {
            transform: translate(-100px, -100px) rotate(-8deg);
        }

        .collage-v4:hover .img-3 {
            transform: scale(1.12);
        }

        .collage-v4:hover .img-4 {
            transform: translate(-100px, 100px) rotate(8deg);
        }

        .collage-v4:hover .img-5 {
            transform: translate(100px, 100px) rotate(-8deg);
        }

        h2 {
            line-height: 1.2 !important;
            /* Force global consistency for headings */
        }

        /* Criteria Scroll Animation Styles */
        .criteria-section {
            height: 400vh;
            position: relative;
        }

        .criteria-sticky {
            position: sticky;
            top: 0;
            height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: flex-start;
            overflow: hidden;
            background: white;
            padding-top: 2rem;
        }

        .laptop-mockup-container {
            position: relative;
            width: 100%;
            max-width: 1400px;
            margin-top: 3rem;
            transform-origin: center;
            transition: transform 0.1s ease-out;
            z-index: 10;
        }

        .criteria-card-reveal {
            position: absolute;
            background: white;
            padding: 2rem;
            border-radius: 2rem;
            box-shadow: 0 15px 45px rgba(0, 0, 0, 0.05);
            width: 550px;
            min-height: 260px;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.6s ease-out, transform 0.6s cubic-bezier(0.25, 1, 0.5, 1);
            border: 1px solid #999999;
            z-index: 20;
        }

        .feature-icon {
            width: 40px;
            height: 40px;
            background: #f8f9fa;
            border: 1px solid #eee;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 1rem;
            color: #111;
        }

        .criteria-card-reveal.active {
            opacity: 1;
            pointer-events: auto;
        }

        /* Refined Positions for the new 1.0 Final Scale */
        @media (min-width: 1024px) {
            .card-top-left {
                top: 10%;
                left: 1px;
            }

            .card-top-right {
                top: 10%;
                right: 1px;
            }

            .card-bottom-left {
                bottom: 8%;
                left: 138px;
            }

            .card-bottom-right {
                bottom: 8%;
                right: 138px;
            }
        }

        .criteria-card-reveal.active {
            opacity: 1;
            pointer-events: auto;
        }

        /* Fixed translateY animation that doesn't mess with horizontal pixel positions */
        @media (min-width: 1024px) {
            #card-1.active {
                transform: translateY(-20px);
            }

            #card-2.active {
                transform: translateY(-20px);
            }

            #card-3.active {
                transform: translateY(20px);
            }

            #card-4.active {
                transform: translateY(20px);
            }
        }

        /* Mobile Adjustments (Stacks nicely) */
        @media (max-width: 1023px) {
            .criteria-section {
                height: auto;
            }

            .criteria-sticky {
                position: relative;
                height: auto;
                padding: 2rem 0;
            }

            .laptop-mockup-container {
                transform: scale(1) !important;
                margin: 2rem 0;
            }

            .criteria-card-reveal {
                position: relative;
                opacity: 1;
                top: auto !important;
                left: auto !important;
                right: auto !important;
                bottom: auto !important;
                width: 100%;
                max-width: 500px;
                margin: 1rem auto;
            }
        }

        .btn-black {
            background: #000;
            color: #fff;
            padding: 14px 36px;
            border-radius: 9999px;
            font-weight: 700;
            font-size: 14px;
            letter-spacing: 0.05em;
            text-transform: uppercase;
            transition: all 0.3s ease;
            display: inline-block;
        }

        .btn-black:hover {
            background: #026937;
            transform: translateY(-3px);
            box-shadow: 0 15px 30px rgba(2, 105, 55, 0.2);
        }

        /* Scroll Reveal Animations */
        .reveal-on-scroll {
            opacity: 0;
            transform: translateY(40px);
            transition: all 0.8s cubic-bezier(0.2, 0.8, 0.2, 1);
        }

        .reveal-visible {
            opacity: 1 !important;
            transform: translateY(0) !important;
        }

        .stagger-1 {
            transition-delay: 0.1s;
        }

        .stagger-2 {
            transition-delay: 0.2s;
        }

        .stagger-3 {
            transition-delay: 0.3s;
        }

        .stagger-4 {
            transition-delay: 0.4s;
        }

        .content-image {
            border-radius: 1.5rem;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.15);
        }
    </style>
</head>

<body class="font-sans antialiased">
    <!-- Main Header -->
    <header class="bg-brand text-white">
        <div class="max-w-8xl mx-auto px-6 md:px-12 py-6">
            <div class="flex flex-col lg:flex-row justify-between items-start lg:items-center gap-6 mb-4">
                <!-- Logo Container (Extra large with no layout impact) -->
                <div class="relative h-16 w-80 flex items-center">
                    <img src="assets/logo/tunamsam.webp" alt="TunamSam Logo"
                        class="absolute -top-12 left-0 h-48 w-auto object-contain z-50 transform hover:scale-105 transition-transform cursor-pointer" />
                </div>

                <!-- Contact Info Section -->
                <div
                    class="hidden lg:flex items-center lg:space-x-6 xl:space-x-10 text-[14px] font-medium whitespace-nowrap">
                    <div class="flex items-center space-x-2">
                        <i data-lucide="map-pin" class="w-4 h-4 text-white opacity-80"></i>
                        <span>Bali, Indonesia</span>
                    </div>
                    <div class="flex items-center space-x-2">
                        <i data-lucide="mail" class="w-4 h-4 text-white opacity-80"></i>
                        <span>tunamsam@gmail.com</span>
                    </div>
                    <div class="flex items-center space-x-2">
                        <i data-lucide="phone" class="w-4 h-4 text-white opacity-80"></i>
                        <span>+62 851-9096-2301</span>
                    </div>
                </div>

                <!-- Social Media Icons (Using Font Awesome Brands) -->
                <div class="flex items-center space-x-2">
                    <a href="https://www.instagram.com/tunamsam/"
                        class="w-10 h-10 bg-white text-brand rounded-full flex items-center justify-center hover:bg-brand-light hover:text-white transition-all shadow-md">
                        <i class="fa-brands fa-instagram text-xl"></i>
                    </a>
                    <a href="https://www.tiktok.com/@tunamsam"
                        class="w-10 h-10 bg-white text-brand rounded-full flex items-center justify-center hover:bg-brand-light hover:text-white transition-all shadow-md">
                        <i class="fa-brands fa-tiktok text-lg"></i>
                    </a>
                    <a href="https://www.linkedin.com/company/tunamsam"
                        class="w-10 h-10 bg-white text-brand rounded-full flex items-center justify-center hover:bg-brand-light hover:text-white transition-all shadow-md">
                        <i class="fa-brands fa-linkedin-in text-xl"></i>
                    </a>
                </div>
            </div>

            <div class="flex flex-col md:flex-row justify-between items-center pt-6">
                <nav
                    class="flex flex-wrap justify-center md:justify-start items-center gap-6 lg:gap-10 text-[13px] font-bold uppercase tracking-wider mb-6 md:mb-0">
                    <a href="#home" class="hover:opacity-70 transition-opacity" data-i18n="home">Home</a>
                    <a href="#services" class="hover:opacity-70 transition-opacity" data-i18n="services">Layanan</a>
                    <a href="#portfolio" class="hover:opacity-70 transition-opacity" data-i18n="portfolio">Portfolio</a>
                    <a href="#about" class="hover:opacity-70 transition-opacity" data-i18n="profile">Profil</a>
                    <a href="#contact" class="hover:opacity-70 transition-opacity" data-i18n="contact">Kontak</a>
                </nav>

                <div class="flex items-center space-x-6">
                    <!-- Language Selector Main Header -->
                    <div class="relative group">
                        <div id="lang-toggle-header"
                            class="flex items-center space-x-2 text-[13px] font-bold uppercase cursor-pointer hover:opacity-80 transition-opacity">
                            <img id="current-flag-header" src="https://flagcdn.com/w20/id.webp" alt="ID"
                                class="w-5 h-auto">
                            <span id="current-lang-header">ID</span>
                            <i data-lucide="chevron-down" class="w-4 h-4"></i>
                        </div>
                        <div id="lang-menu-header" class="lang-dropdown">
                            <div class="py-1">
                                <div onclick="changeLang('ID', 'https://flagcdn.com/w20/id.webp')"
                                    class="flex items-center space-x-3 px-4 py-2 hover:bg-gray-100 cursor-pointer text-gray-800 text-[12px] font-bold">
                                    <img src="https://flagcdn.com/w20/id.webp" alt="ID" class="w-5 h-auto">
                                    <span>ID - Indonesia</span>
                                </div>
                                <div onclick="changeLang('EN', 'https://flagcdn.com/w20/gb.webp')"
                                    class="flex items-center space-x-3 px-4 py-2 hover:bg-gray-100 cursor-pointer text-gray-800 text-[12px] font-bold">
                                    <img src="https://flagcdn.com/w20/gb.webp" alt="EN" class="w-5 h-auto">
                                    <span>EN - English</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <a href="https://wa.me/+6285190962301"
                        class="px-8 py-2 bg-brand-light hover:bg-white hover:text-brand-light text-white text-[13px] font-bold rounded-full flex items-center space-x-3 shadow-xl transition-all">
                        <i class="fa-brands fa-whatsapp text-xl"></i>
                        <span data-i18n="contact_us">Hubungi Kami</span>
                    </a>
                </div>
            </div>
        </div>
    </header>



    <!-- Hero Section -->
    <section id="home" class="relative bg-brand pb-24 overflow-hidden">
        <div class="max-w-7xl mx-auto px-6 md:px-12 relative z-20">
            <div class="relative">
                <div
                    class="slider-container aspect-video md:aspect-[16/7] rounded-[2.5rem] overflow-hidden shadow-2xl bg-black">
                    <div class="slide active">
                        <img src="/assets/hero-section-assets/banner1.webp" alt="Slide 1" class="w-full h-full object-cover">
                    </div>
                    <div class="slide">
                        <img src="/assets/hero-section-assets/banner2.webp" alt="Slide 2" class="w-full h-full object-cover">
                    </div>
                    <div class="slide">
                        <img src="/assets/hero-section-assets/banner3.webp" alt="Slide 3" class="w-full h-full object-cover">
                    </div>
                    <div class="slide">
                        <img src="/assets/hero-section-assets/banner4.webp" alt="Slide 4" class="w-full h-full object-cover">
                    </div>
                </div>

                <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex space-x-3 z-30">
                    <div
                        class="slide-dot cursor-pointer transition-all duration-300 relative overflow-hidden rounded-full">
                    </div>
                    <div
                        class="slide-dot cursor-pointer transition-all duration-300 relative overflow-hidden rounded-full">
                    </div>
                    <div
                        class="slide-dot cursor-pointer transition-all duration-300 relative overflow-hidden rounded-full">
                    </div>
                    <div
                        class="slide-dot cursor-pointer transition-all duration-300 relative overflow-hidden rounded-full">
                    </div>
                </div>
            </div>
        </div>

        <div class="wave-container">
            <svg viewBox="0 0 1920 320" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
                <path class="wave-path-3" fill="#ffffff" fill-opacity="0.3"
                    d="M0,160 C320,300 640,20 960,160 C1280,300 1600,20 1920,160 L1920,320 L0,320 Z"></path>
                <path class="wave-path-2" fill="#ffffff" fill-opacity="0.6"
                    d="M0,160 C320,20 640,300 960,160 C1280,20 1600,300 1920,160 L1920,320 L0,320 Z"></path>
                <path class="wave-path-1" fill="#ffffff"
                    d="M0,192 C240,320 720,64 960,192 C1200,320 1680,64 1920,192 L1920,320 L0,320 Z"></path>
            </svg>
        </div>
    </section>

    <!-- Trusted By Section -->
    <section class="pt-32 pb-32 bg-white">
        <div class="max-w-6xl mx-auto px-6 text-center">
            <p class="text-gray-500 font-sans mb-10" data-i18n="trusted_by">Telah dipercaya oleh:</p>

            <div class="flex flex-wrap justify-center items-center gap-x-12 gap-y-10 md:gap-x-16 lg:gap-x-20">
                <img src="assets/logo/nasi-goreng-mbak-win.webp" alt="Client 1" style="width: 110px; height: auto;"
                    class="grayscale opacity-50 hover:grayscale-0 hover:opacity-100 transition-all cursor-pointer">
            </div>
        </div>
    </section>

    <!-- Problem & Solution Sections (4 Blocks Total) -->
    <section class="py-24 bg-white overflow-hidden">
        <div class="max-w-8xl mx-auto px-6 md:px-12 space-y-40">

            <!-- Block 1: Problem Website (Text Left, Image Right) -->
            <div class="flex flex-col lg:flex-row items-center gap-20">
                <div class="lg:w-1/2 space-y-6">
