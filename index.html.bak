        // Criteria Shrink Animation Logic
        window.addEventListener('scroll', () => {
            const criteriaSection = document.querySelector('.criteria-section');
            const laptop = document.querySelector('.laptop-mockup-container');
            const cards = [
                document.getElementById('card-1'),
                document.getElementById('card-2'),
                document.getElementById('card-3'),
                document.getElementById('card-4')
            ];

            if (!criteriaSection || !laptop) return;

            const sectionTop = criteriaSection.offsetTop;
            const sectionHeight = criteriaSection.offsetHeight;
            const scrollY = window.scrollY;

            // Only animate when sticky section is active
            if (scrollY < sectionTop || scrollY > sectionTop + sectionHeight - window.innerHeight) {
                if (scrollY < sectionTop) {
                    laptop.style.transform = `scale(1.1)`;
                    cards.forEach(c => c && c.classList.remove('active'));
                }
                return;
            }

            // Added 800px offset for a long "dead zone" so the laptop stays static first
            const startOffset = 500;
            let scrollProgress = (scrollY - (sectionTop + startOffset)) / (sectionHeight - window.innerHeight - startOffset);
            scrollProgress = Math.max(0, Math.min(1, scrollProgress));

            // Shrink Laptop: From scale 1.1 to 1.0
            const scale = 1.1 - (scrollProgress * 0.1);
            laptop.style.transform = `scale(${scale})`;

            // Reveal Cards with significantly delayed thresholds (50% and 80%)
            if (scrollProgress > 0.5) {
                if (cards[0]) cards[0].classList.add('active');
                if (cards[1]) cards[1].classList.add('active');
            } else {
                if (cards[0]) cards[0].classList.remove('active');
                if (cards[1]) cards[1].classList.remove('active');
            }

            if (scrollProgress > 0.8) {
                if (cards[2]) cards[2].classList.add('active');
                if (cards[3]) cards[3].classList.add('active');
            } else {
                if (cards[2]) cards[2].classList.remove('active');
                if (cards[3]) cards[3].classList.remove('active');
            }
        });

        function changeLang(lang, flagUrl) {
            // Update Toggle UI
            if (document.getElementById('current-flag-header')) {
                document.getElementById('current-flag-header').src = flagUrl;
                document.getElementById('current-flag-header').alt = lang;
            }
            if (document.getElementById('current-lang-header')) {
                document.getElementById('current-lang-header').innerText = lang;
            }

            const elements = document.querySelectorAll('[data-i18n]');
            elements.forEach(el => {
                const key = el.getAttribute('data-i18n');
                if (translations[lang] && translations[lang][key]) {
                    el.innerText = translations[lang][key];
                }
            });

            // Close menus
            document.querySelectorAll('.lang-dropdown').forEach(m => m.classList.remove('show'));
        }

        // Language Switcher Logic
        function toggleLangMenu(id) {
            const menu = document.getElementById(id);
            const allMenus = document.querySelectorAll('.lang-dropdown');
            allMenus.forEach(m => {
                if (m.id !== id) m.classList.remove('show');
            });
            menu.classList.toggle('show');
        }

        document.getElementById('lang-toggle-header').addEventListener('click', (e) => {
            e.stopPropagation();
            toggleLangMenu('lang-menu-header');
        });

        window.addEventListener('click', () => {
            document.querySelectorAll('.lang-dropdown').forEach(m => m.classList.remove('show'));
        });

        // Slider
        const slides = document.querySelectorAll('.slide');
        const dots = document.querySelectorAll('.slide-dot');
        let currentSlide = 0;
        let slideInterval;

        function updateSlider(index) {
            slides.forEach(s => s.classList.remove('active'));
            dots.forEach(d => {
                d.className = 'slide-dot cursor-pointer transition-all duration-300 relative overflow-hidden rounded-full bg-[#d4d4d4] w-3 h-3';
                d.innerHTML = '';
            });

            slides[index].classList.add('active');
            dots[index].className = 'slide-dot cursor-pointer transition-all duration-300 relative overflow-hidden rounded-full bg-[#d4d4d4] w-12 h-3';
            dots[index].innerHTML = '<div class="absolute top-0 left-0 h-full bg-brand animate-slider-progress"></div>';
        }

        function startSlideInterval() {
            clearInterval(slideInterval);
            slideInterval = setInterval(() => {
                currentSlide = (currentSlide + 1) % slides.length;
                updateSlider(currentSlide);
            }, 5000);
        }

        dots.forEach((dot, index) => {
            dot.addEventListener('click', () => {
                currentSlide = index;
                updateSlider(currentSlide);
                startSlideInterval();
            });
        });

        updateSlider(0);
        startSlideInterval();

        // Scroll Reveal Observer
        const revealObserver = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('reveal-visible');
                }
            });
        }, { threshold: 0.1 });

        document.querySelectorAll('.reveal-on-scroll').forEach(el => revealObserver.observe(el));

        // Process Step Scroll Tracker
        (function () {
            const processHeader = document.getElementById('process-header');
            const processSection = document.getElementById('process');
            const processSteps = document.querySelectorAll('.process-step[data-step]');
            const processDots = document.querySelectorAll('.process-dot');
            const processLines = document.querySelectorAll('.process-line');

            if (!processHeader || processSteps.length === 0) return;

            // Set CSS var for sticky top positions based on actual header height
            function updateHeaderHeight() {
                const h = processHeader.offsetHeight;
                document.documentElement.style.setProperty('--process-header-height', h + 'px');
            }
            updateHeaderHeight();
            window.addEventListener('resize', updateHeaderHeight);

            function setActiveDot(activeStep) {
                processDots.forEach(dot => {
                    const step = parseInt(dot.getAttribute('data-step'));
                    if (step <= activeStep) {
                        dot.style.borderColor = 'white';
                        dot.style.color = 'white';
                    } else {
                        dot.style.borderColor = '#4b5563';
                        dot.style.color = '#6b7280';
                    }
                    // Active (current) step gets a filled white circle
                    if (step === activeStep) {
                        dot.style.background = 'white';
                        dot.style.color = '#0a0a0a';
                        dot.style.fontWeight = '900';
                    } else if (step < activeStep) {
                        dot.style.background = 'white';
                        dot.style.color = 'black';
                    } else {
                        dot.style.background = '#0a0a0a';
                    }
                });
                processLines.forEach(line => {
                    const step = parseInt(line.getAttribute('data-step'));
                    line.style.backgroundColor = step < activeStep ? 'white' : '#374151';
                });
            }

            window.addEventListener('scroll', () => {
                if (!processSection) return;
                const sectionRect = processSection.getBoundingClientRect();
                // Not in view
                if (sectionRect.bottom < 0 || sectionRect.top > window.innerHeight) return;

                let activeStep = 1;
                processSteps.forEach(step => {
                    const rect = step.getBoundingClientRect();
                    const headerH = processHeader.offsetHeight;
                    // Card is considered "active" when its top is at or above center of sticky header
                    if (rect.top <= headerH + 80) {
                        activeStep = parseInt(step.getAttribute('data-step'));
                    }
                });
                setActiveDot(activeStep);
            }, { passive: true });

            // Initialize
            setActiveDot(1);
        })();
    </script>
</body>

</html>